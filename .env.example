# Application Configuration
# -------------------------
# Public base URL of the running application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment mode (development, staging, production)
NODE_ENV=development

# Support & Contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Supabase & Database Configuration
# ---------------------------------
# Local Supabase default endpoints (started via `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: GST APIs & External Services
# GST_API_URL=https://api.example.com/gst
# GST_API_KEY=your-gst-api-key-here
